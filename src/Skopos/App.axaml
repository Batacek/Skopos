<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skopos.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system theme; ThemeManager then switches it at runtime from settings. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://skopos/Styles/Skopos.axaml" />
    </Application.Styles>
</Application>