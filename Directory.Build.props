<Project>

  <!-- Shared properties for every project. Package versions live in Directory.Packages.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Product>Skopos</Product>
    <Company>Skopos</Company>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
  </PropertyGroup>

  <!-- AOT-compatible code from day one, so it never has to be retrofitted. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Skopos.Tests'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
